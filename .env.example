# Telegram 频道用户名（不带 @）
CHANNEL=shenzjd_com

# 语言与时区
LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

# 静态资源代理前缀（GFW 绕行，必须启用 /static/）
STATIC_PROXY=/static/

# Telegram 主机名（服务端抓取用，需服务端可出墙访问）
TELEGRAM_HOST=t.me

# 站点 URL（用于 RSS / Sitemap / OG / canonical）
# ⚠️ 生产环境必填：缺省会回退到 astro.config 的 site+base，最终被请求 origin 兜底——
# 一旦有人用服务器 IP 访问（直接 IP / 反代 Host 头没改 / CDN 回源），
# canonical / og:url / favicon / apple-touch-icon 会泄露 IP。
# 末尾可加可不加 "/"（代码会自动补 "/"），建议加：
SITE_URL=https://shenzjd.com/

# 评论与反应（reactions 原生支持；comments 为可选 Telegram 评论组件）
COMMENTS=true
REACTIONS=true

# 隐藏频道描述
HIDE_DESCRIPTION=false

# 标签 / 链接 / 导航（分号分隔；导航格式 标题,URL;标题,URL）
# 导航默认已内置为「社交平台 / 在线服务」两组（见 src/lib/nav.ts），无需设置即可生效；
# 如需自定义，用 NAVS 覆盖为扁平列表：标题,URL;标题,URL
TAGS=
LINKS=
NAVS=

# 社交链接
TELEGRAM=shenzjd_com
TWITTER=
GITHUB=wu529778790
DISCORD=
PODCAST=
MASTODON=
BLUESKY=

# SEO
NOFOLLOW=false
NOINDEX=false

# 页头/页脚注入（支持 HTML）
HEADER_INJECT=
FOOTER_INJECT=

# Google 站内搜索（填域名启用，否则用内置搜索）
GOOGLE_SEARCH_SITE=

# RSS 美化
RSS_BEAUTIFY=

# 小程序接口外链脱敏（微信审核合规用，默认开启）
# 开启时 /api/posts.json 的 desc 与 /api/posts/{id} 的 content_html 会移除所有站外链接，
# GitHub 仓库链接改写为纯文本「GitHub：owner/repo」；审核通过后想恢复正常链接，设 false 即可：
MINI_PROGRAM_SANITIZE_LINKS=true

# 诊断日志（默认关闭，排查时置 1 即可，零开销）
# DIAG_ACCESS 已废弃：逐请求 ACCESS 日志已从代码中移除，不再受环境变量控制
# DIAG_TELEGRAM=1 Telegram 抓取诊断：成功不逐条记录，仅 ERROR 全量 + SLOW(≥3s) + 每 5 分钟 summary
DIAG_TELEGRAM=
DIAG_CACHE_STATS=

# Telegram HTML 缓存最大条目数（LRU 淘汰）
# 实测单条约 64KB；512 条 ≈ 32MB 字符串数据（实际堆内存约 2 倍）。
# 低配服务器保持 512 即可；内存宽裕可试 1024-2048。
TELEGRAM_HTML_CACHE_MAX=512

# 应用层全页 HTML 缓存（缓存渲染完成的最终页面，命中跳过抓取+解析+渲染）
# PAGE_CACHE_MAX 条目数（默认 64，单页 ~50-200KB ≈ 3-13MB 内存）
# PAGE_CACHE_TTL 秒（默认 300，与 Cache-Control max-age 一致）
PAGE_CACHE_MAX=64
PAGE_CACHE_TTL=300

# X (Twitter) 源：聚合到首页时间线（与 Telegram 合并展示）
# 逗号分隔多个账号 handle；未登录抓取用户页最近 5 条推文，
# 历史由服务端增量持久化积累（data/x-feed.json，需挂载卷持久化）
X_USERS=shenzujiudi
# X 页面 HTML 缓存条目数（默认 16）
# X_HTML_CACHE_MAX=16
# X 数据持久化目录（默认 ./data；Docker 部署挂载 /app/data）
# X_DATA_DIR=/app/data
