---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import Item from '../components/item.astro'

const { SITE_URL } = Astro.locals
const { channel, before = true, after = true, isItem = false, pageHeading, pageSeo } = Astro.props
const posts = channel.posts ?? []

// Pagination cursors are Telegram message IDs (pure digits). X tweets merged
// into the home timeline carry prefixed ids (x-handle-...) and must not
// participate in cursor pagination.
const tgPosts = posts.filter((post) => /^\d+$/.test(post.id))
const beforeCursor = tgPosts[tgPosts.length - 1]?.id
const afterCursor = tgPosts[0]?.id
const hasOlderPosts = before && beforeCursor && Number(beforeCursor) > 1
const hasNewerPosts = after && afterCursor
const itemsClass = 'post-list mt-5 mb-0 ml-7 list-none pl-0 max-sm:ml-0'
const paginationClass = 'my-5 flex items-center justify-between'
const paginationLinkClass =
  'inline-flex h-9 w-9 items-center justify-center rounded-full border border-line-strong bg-transparent text-lg leading-none text-muted no-underline transition-all duration-200 hover:border-accent hover:bg-accent hover:text-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-heading active:scale-95'
const paginationNewerClass = 'ml-auto'
---

<Layout channel={channel} seo={pageSeo}>
  {pageHeading ? <h1 class="sr-only">{pageHeading}</h1> : null}
  <slot name="header">
    <Header channel={channel} />
  </slot>
  <ol class={itemsClass} aria-label={isItem ? 'Post' : 'Posts'}>
    {
      posts.map((post) => (
        <li>
          <Item post={post} isItem={isItem} />
        </li>
      ))
    }
  </ol>

  {
    hasOlderPosts || hasNewerPosts ? (
      <nav class={paginationClass} aria-label="Pagination">
        {hasOlderPosts ? (
          <a
            href={`${SITE_URL}before/${beforeCursor}`}
            title="Older posts"
            aria-label="Older posts"
            class={paginationLinkClass}
          >
            <span aria-hidden="true">←</span>
          </a>
        ) : null}
        {hasNewerPosts ? (
          <a
            href={`${SITE_URL}after/${afterCursor}`}
            title="Newer posts"
            aria-label="Newer posts"
            class:list={[paginationLinkClass, paginationNewerClass]}
          >
            <span aria-hidden="true">→</span>
          </a>
        ) : null}
      </nav>
    ) : null
  }
</Layout>
