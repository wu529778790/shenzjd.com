---
import SearchField from './SearchField.astro'

const { action, googleSearchSite } = Astro.props

// 紧凑下划线式搜索框,作为文章列表顶部的工具条
const searchFormClass =
  'flex w-40 items-center gap-1 rounded-md border-b border-line/40 bg-transparent px-1 py-1 text-muted transition-colors duration-150 focus-within:border-heading/40 md:w-48'
---

<form class={searchFormClass} action={action} method="get" role="search" aria-label="Site search">
  <SearchField id="site-search-query" googleSearchSite={googleSearchSite} />
</form>
